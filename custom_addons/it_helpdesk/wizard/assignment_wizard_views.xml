<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_helpdesk_assignment_wizard_form"
        model="ir.ui.view">
        <field name="name">it.helpdesk.assignment.wizard.form</field>
        <field name="model">it.helpdesk.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="담당자 배정">
                <group>
                    <field name="ticket_id" invisible="1" />
                    <field name="assigned_user_id"
                        options="{'no_create': True, 'no_create_edit': True}" />
                </group>
                <footer>
                    <button name="action_confirm"
                        string="배정하기"
                        type="object"
                        class="btn-primary" />
                    <button string="취소"
                        special="cancel"
                        class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_it_helpdesk_assignment_wizard"
        model="ir.actions.act_window">
        <field name="name">담당자 배정</field>
        <field name="res_model">it.helpdesk.assignment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id"
            ref="view_it_helpdesk_assignment_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- F-03 담당자용 전체 문의 목록 -->
    <record id="view_it_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">it.helpdesk.ticket.list</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="전체 문의 목록"
                default_order="priority_order desc, create_date asc">
                <field name="reference" string="문의 번호" />
                <field name="name" string="제목" />
                <field name="category_id" string="유형" />
                <field name="priority" string="긴급도"
                       widget="badge"
                       decoration-muted="priority == 'low'"
                       decoration-info="priority == 'normal'"
                       decoration-warning="priority == 'high'"
                       decoration-danger="priority == 'urgent'" />
                <field name="state" string="상태" widget="badge"
                       decoration-info="state in ('assigned', 'in_progress', 'reopened_in_progress')"
                       decoration-success="state in ('resolved', 'closed')"
                       decoration-warning="state == 'reopen_requested'" />
                <field name="assigned_user_id" string="담당자" />
                <field name="requester_id" string="요청자" />
                <field name="create_date" string="등록일" />
            </list>
        </field>
    </record>

    <!-- F-04 문의 등록 / F-05 문의 상세 -->
    <record id="view_it_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">it.helpdesk.ticket.form</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="IT 장애 문의" class="o_it_helpdesk_ticket_form">
                <header>
                    <!-- 담당자 미배정: 신규 배정 -->
                    <button
                        name="%(it_helpdesk.action_it_helpdesk_assignment_wizard)d"
                        string="담당자 배정"
                        type="action"
                        class="btn-primary"
                        groups="it_helpdesk.group_it_helpdesk_agent"
                        context="{'default_ticket_id': id}"
                        invisible="not id or assigned_user_id or state == 'closed'"
                    />

                    <!-- 담당자 배정 완료: 담당자 변경 -->
                    <button
                        name="%(it_helpdesk.action_it_helpdesk_assignment_wizard)d"
                        string="담당자 변경"
                        type="action"
                        class="btn-secondary"
                        groups="it_helpdesk.group_it_helpdesk_agent"
                        context="{'default_ticket_id': id}"
                        invisible="not id or not assigned_user_id or state == 'closed'"
                    />

                    <!-- 최초 처리 시작 -->
                    <button
                        name="action_start_progress"
                        string="처리 시작"
                        type="object"
                        class="btn-primary"
                        groups="it_helpdesk.group_it_helpdesk_agent"
                        invisible="not id or state != 'assigned'"
                    />

                    <!-- 재처리 시작 -->
                    <button
                        name="action_start_reopen"
                        string="재처리 시작"
                        type="object"
                        class="btn-primary"
                        groups="it_helpdesk.group_it_helpdesk_agent"
                        invisible="not id or state != 'reopen_requested'"
                    />

                    <!-- 해결 처리 -->
                    <button
                        name="%(it_helpdesk.action_it_helpdesk_resolution_wizard)d"
                        string="해결 처리"
                        type="action"
                        class="btn-primary"
                        context="{'default_ticket_id': id}"
                        groups="it_helpdesk.group_it_helpdesk_agent"
                        invisible="not id or state not in ('in_progress', 'reopened_in_progress')"
                    />

                    <!-- 요청자 재처리 요청 -->
                    <button
                        name="%(it_helpdesk.action_it_helpdesk_reopen_wizard)d"
                        string="재처리 요청"
                        type="action"
                        class="btn-secondary"
                        context="{'default_ticket_id': id}"
                        invisible="not id or state != 'resolved' or requester_id != uid"
                    />

                    <!-- 요청자 종료 승인 -->
                    <button
                        name="%(it_helpdesk.action_it_helpdesk_close_wizard)d"
                        string="종료 승인"
                        type="action"
                        class="btn-primary"
                        context="{'default_ticket_id': id}"
                        invisible="not id or state != 'resolved' or requester_id != uid"
                    />

                    <button
                        name="action_create_faq_draft"
                        string="FAQ 초안 생성"
                        type="object"
                        class="btn-secondary"
                        groups="it_helpdesk.group_it_helpdesk_agent"
                        invisible="not id or state not in ('resolved', 'closed')"
                    />
                </header>

                <sheet>
                    <!-- 문의 원본 정보 -->
                    <group string="문의 등록">
                        <group>
                            <!-- IT 담당자: 신규 등록 시 입력, 저장 후 읽기 전용 -->
                            <field
                                name="category_id"
                                groups="it_helpdesk.group_it_helpdesk_agent"
                                readonly="id != False"
                                domain="[('active', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                            />
                            <field
                                name="name"
                                groups="it_helpdesk.group_it_helpdesk_agent"
                                readonly="id != False"
                                widget="it_helpdesk_faq_recommendation"
                            />

                            <!-- 일반 직원: 접수·미배정일 때만 수정 -->
                            <field
                                name="category_id"
                                groups="!it_helpdesk.group_it_helpdesk_agent"
                                readonly="id != False and (state != 'received' or assigned_user_id != False)"
                                domain="[('active', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                            />
                            <field
                                name="name"
                                groups="!it_helpdesk.group_it_helpdesk_agent"
                                readonly="id != False and (state != 'received' or assigned_user_id != False)"
                                widget="it_helpdesk_faq_recommendation"
                            />

                            <!-- 긴급도: IT 담당자는 종료 전 변경 가능 -->
                            <field
                                name="priority"
                                groups="it_helpdesk.group_it_helpdesk_agent"
                                readonly="state == 'closed'"
                            />
                            <field
                                name="priority"
                                groups="!it_helpdesk.group_it_helpdesk_agent"
                                readonly="id != False"
                            />
                        </group>

                        <group>
                            <!-- IT 담당자: 신규 등록 시 입력, 저장 후 읽기 전용 -->
                            <field
                                name="location"
                                groups="it_helpdesk.group_it_helpdesk_agent"
                                readonly="id != False"
                            />
                            <field
                                name="contact"
                                groups="it_helpdesk.group_it_helpdesk_agent"
                                readonly="id != False"
                            />

                            <!-- 일반 직원: 접수·미배정일 때만 수정 -->
                            <field
                                name="location"
                                groups="!it_helpdesk.group_it_helpdesk_agent"
                                readonly="id != False and (state != 'received' or assigned_user_id != False)"
                            />
                            <field
                                name="contact"
                                groups="!it_helpdesk.group_it_helpdesk_agent"
                                readonly="id != False and (state != 'received' or assigned_user_id != False)"
                            />
                        </group>
                    </group>

                    <!-- 문의 내용 -->
                    <group string="장애 상세 내용">
                        <!-- IT 담당자: 신규 등록 시 입력, 저장 후 읽기 전용 -->
                        <field
                            name="description"
                            nolabel="1"
                            colspan="2"
                            groups="it_helpdesk.group_it_helpdesk_agent"
                            readonly="id != False"
                            placeholder="발생한 IT 장애 증상과 상황을 자세히 입력해 주세요."
                        />

                        <!-- 일반 직원: 접수·미배정일 때만 수정 -->
                        <field
                            name="description"
                            nolabel="1"
                            colspan="2"
                            groups="!it_helpdesk.group_it_helpdesk_agent"
                            readonly="id != False and (state != 'received' or assigned_user_id != False)"
                            placeholder="발생한 IT 장애 증상과 상황을 자세히 입력해 주세요."
                        />
                    </group>

                    <!-- 처리 정보 -->
                    <group string="처리 정보" invisible="not id">
                        <group>
                            <field name="reference" readonly="1" />
                            <field name="requester_id" readonly="1" />
                        </group>
                        <group>
                            <field name="state" readonly="1" />
                            <field name="assigned_user_id" readonly="1" />
                        </group>
                    </group>

                    <!-- 해결 정보 -->
                    <group string="해결 정보" invisible="not id">
                        <group>
                            <field name="resolution_method" readonly="1" />
                            <field name="resolved_date" readonly="1" />
                        </group>
                        <group>
                            <field name="closed_date" readonly="1" />
                            <field name="reopen_count" readonly="1" />
                        </group>
                    </group>

                    <!-- 해결 내용 -->
                    <group string="해결 내용" invisible="not id">
                        <field name="resolution" readonly="1" />
                    </group>

                    <!-- 변경 이력 -->
                    <div class="o_it_helpdesk_history_section" invisible="not id">
                        <separator string="변경 이력" />
                        <field
                            name="history_ids"
                            nolabel="1"
                            readonly="1"
                        >
                            <list
                                create="false"
                                edit="false"
                                delete="false"
                            >
                                <field
                                    name="change_date"
                                    string="변경 일시"
                                />
                                <field
                                    name="change_type"
                                    string="변경 유형"
                                />
                                <field
                                    name="old_value"
                                    string="변경 전"
                                />
                                <field
                                    name="new_value"
                                    string="변경 후"
                                />
                                <field
                                    name="changed_by"
                                    string="변경자"
                                />
                                <field
                                    name="description"
                                    string="내용 및 사유"
                                />
                            </list>
                        </field>
                    </div>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <!-- F-02 직원용 내 문의 목록 -->
    <record id="view_it_helpdesk_my_ticket_list" model="ir.ui.view">
        <field name="name">it.helpdesk.my.ticket.list</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list
                string="내 문의 목록"
                default_order="create_date desc"
            >
                <field name="reference" string="문의 번호" />
                <field name="name" string="제목" />
                <field name="category_id" string="유형" />
                <field name="priority" string="긴급도"
                       widget="badge"
                       decoration-muted="priority == 'low'"
                       decoration-info="priority == 'normal'"
                       decoration-warning="priority == 'high'"
                       decoration-danger="priority == 'urgent'" />
                <field name="state" string="상태" widget="badge"
                       decoration-info="state in ('assigned', 'in_progress', 'reopened_in_progress')"
                       decoration-success="state in ('resolved', 'closed')"
                       decoration-warning="state == 'reopen_requested'" />
                <field name="assigned_user_id" string="담당자" />
                <field name="create_date" string="등록일" />
            </list>
        </field>
    </record>

    <!-- 직원·담당자 공용 내 문의 검색 화면 -->
    <record id="view_it_helpdesk_my_ticket_search" model="ir.ui.view">
        <field name="name">it.helpdesk.my.ticket.search</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="내 문의 검색">
                <field name="reference" />
                <field name="name" />
                <field
                    name="requester_id"
                    groups="it_helpdesk.group_it_helpdesk_agent"
                />
                <field name="category_id" />
                <field name="state" />
                <field name="priority" />
                <field name="assigned_user_id" />

                <separator />

                <filter
                    name="my_assigned"
                    string="내 담당 문의"
                    domain="[('assigned_user_id', '=', uid)]"
                    groups="it_helpdesk.group_it_helpdesk_agent"
                />
                <filter
                    name="unassigned"
                    string="미배정 문의"
                    domain="[('assigned_user_id', '=', False)]"
                    groups="it_helpdesk.group_it_helpdesk_agent"
                />

                <separator />

                <filter
                    name="received"
                    string="접수"
                    domain="[('state', '=', 'received')]"
                />
                <filter
                    name="assigned"
                    string="배정"
                    domain="[('state', '=', 'assigned')]"
                />
                <filter
                    name="in_progress"
                    string="처리 중"
                    domain="[('state', '=', 'in_progress')]"
                />
                <filter
                    name="reopen_requested"
                    string="재처리 요청"
                    domain="[('state', '=', 'reopen_requested')]"
                />
                <filter
                    name="reopened_in_progress"
                    string="재처리 중"
                    domain="[('state', '=', 'reopened_in_progress')]"
                />
                <filter
                    name="resolved"
                    string="해결"
                    domain="[('state', '=', 'resolved')]"
                />
                <filter
                    name="closed"
                    string="종료"
                    domain="[('state', '=', 'closed')]"
                />

                <separator />

                <filter
                    name="priority_low"
                    string="낮음"
                    domain="[('priority', '=', 'low')]"
                />
                <filter
                    name="priority_normal"
                    string="보통"
                    domain="[('priority', '=', 'normal')]"
                />
                <filter
                    name="priority_high"
                    string="높음"
                    domain="[('priority', '=', 'high')]"
                />
                <filter
                    name="urgent"
                    string="긴급"
                    domain="[('priority', '=', 'urgent')]"
                />

                <group>
                    <filter
                        name="group_by_category"
                        string="유형별"
                        context="{'group_by': 'category_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="상태별"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_priority"
                        string="긴급도별"
                        context="{'group_by': 'priority'}"
                    />
                    <filter
                        name="group_by_assigned_user"
                        string="담당자별"
                        context="{'group_by': 'assigned_user_id'}"
                        groups="it_helpdesk.group_it_helpdesk_agent"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- IT 담당자 관리용 검색 화면 -->
    <record id="view_it_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">it.helpdesk.ticket.management.search</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="문의 검색">
                <field name="reference" />
                <field name="name" />
                <field name="requester_id" />
                <field name="category_id" />
                <field name="state" />
                <field name="priority" />
                <field name="assigned_user_id" />

                <separator />

                <filter
                    name="my_assigned"
                    string="내 담당 문의"
                    domain="[('assigned_user_id', '=', uid)]"
                />
                <filter
                    name="unassigned"
                    string="미배정 문의"
                    domain="[('assigned_user_id', '=', False)]"
                />

                <separator />

                <filter
                    name="received"
                    string="접수"
                    domain="[('state', '=', 'received')]"
                />
                <filter
                    name="assigned"
                    string="배정"
                    domain="[('state', '=', 'assigned')]"
                />
                <filter
                    name="in_progress"
                    string="처리 중"
                    domain="[('state', '=', 'in_progress')]"
                />
                <filter
                    name="reopen_requested"
                    string="재처리 요청"
                    domain="[('state', '=', 'reopen_requested')]"
                />
                <filter
                    name="reopened_in_progress"
                    string="재처리 중"
                    domain="[('state', '=', 'reopened_in_progress')]"
                />
                <filter
                    name="resolved"
                    string="해결"
                    domain="[('state', '=', 'resolved')]"
                />
                <filter
                    name="closed"
                    string="종료"
                    domain="[('state', '=', 'closed')]"
                />

                <separator />

                <filter
                    name="priority_low"
                    string="낮음"
                    domain="[('priority', '=', 'low')]"
                />
                <filter
                    name="priority_normal"
                    string="보통"
                    domain="[('priority', '=', 'normal')]"
                />
                <filter
                    name="priority_high"
                    string="높음"
                    domain="[('priority', '=', 'high')]"
                />
                <filter
                    name="urgent"
                    string="긴급"
                    domain="[('priority', '=', 'urgent')]"
                />

                <group>
                    <filter
                        name="group_by_category"
                        string="유형별"
                        context="{'group_by': 'category_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="상태별"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_priority"
                        string="긴급도별"
                        context="{'group_by': 'priority'}"
                    />
                    <filter
                        name="group_by_assigned_user"
                        string="담당자별"
                        context="{'group_by': 'assigned_user_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>

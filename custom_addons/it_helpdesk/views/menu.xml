<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 문의 목록을 여는 액션 -->
    <record id="action_it_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">문의 목록</field>
        <field name="res_model">it.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_it_helpdesk_ticket_search" />
    </record>

    <!-- IT Helpdesk 최상위 메뉴 -->
    <menuitem
        id="menu_it_helpdesk_root"
        name="IT Helpdesk"
        sequence="10"
    />

    <record id="action_it_helpdesk_dashboard" model="ir.actions.client">
        <field name="name">대시보드</field>
        <field name="tag">it_helpdesk.dashboard</field>
    </record>

    <menuitem
        id="menu_it_helpdesk_dashboard"
        name="대시보드"
        parent="menu_it_helpdesk_root"
        action="action_it_helpdesk_dashboard"
        groups="it_helpdesk.group_it_helpdesk_user"
        sequence="1"
    />

    <!-- 문의 관리 메뉴 -->
    <menuitem
        id="menu_it_helpdesk_tickets"
        name="문의 관리"
        parent="menu_it_helpdesk_root"
        sequence="10"
    />

    <!-- F-03 담당자용 전체 문의 목록 -->
    <menuitem
        id="menu_it_helpdesk_ticket_list"
        name="문의 목록"
        parent="menu_it_helpdesk_tickets"
        action="action_it_helpdesk_ticket"
        groups="it_helpdesk.group_it_helpdesk_agent"
        sequence="10"
    />

    <!-- F-02 내 문의 목록 액션 -->
    <record id="action_it_helpdesk_my_tickets" model="ir.actions.act_window">
        <field name="name">내 문의 목록</field>
        <field name="res_model">it.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="context">{'default_requester_id': uid}</field>
        <field name="search_view_id" ref="view_it_helpdesk_my_ticket_search" />
    </record>

    <!-- 직원용 List View 연결 -->
    <record id="action_it_helpdesk_my_tickets_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_it_helpdesk_my_ticket_list" />
        <field name="act_window_id" ref="action_it_helpdesk_my_tickets" />
    </record>

    <!-- F-02 내 문의 메뉴 -->
    <menuitem
        id="menu_it_helpdesk_my_tickets"
        name="내 문의"
        parent="menu_it_helpdesk_tickets"
        action="action_it_helpdesk_my_tickets"
        groups="it_helpdesk.group_it_helpdesk_user"
        sequence="5"
    />

    <menuitem
        id="menu_it_helpdesk_faq_public"
        name="FAQ / 해결 가이드"
        parent="menu_it_helpdesk_root"
        action="action_it_helpdesk_faq_public"
        groups="it_helpdesk.group_it_helpdesk_user"
        sequence="20"
    />

    <!-- 담당자용 List View 연결 -->
    <record id="action_it_helpdesk_ticket_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_it_helpdesk_ticket_list" />
        <field name="act_window_id" ref="action_it_helpdesk_ticket" />
    </record>

    <!-- F-03 미배정 문의 액션 -->
    <record id="action_it_helpdesk_unassigned_tickets" model="ir.actions.act_window">
        <field name="name">미배정 문의</field>
        <field name="res_model">it.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('assigned_user_id', '=', False)]</field>
        <field name="search_view_id" ref="view_it_helpdesk_ticket_search" />
    </record>

    <!-- 기존 F-03 전체 문의 List View 재사용 -->
    <record id="action_it_helpdesk_unassigned_tickets_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_it_helpdesk_ticket_list" />
        <field name="act_window_id" ref="action_it_helpdesk_unassigned_tickets" />
    </record>

    <!-- F-03 담당자용 미배정 문의 메뉴 -->
    <menuitem
        id="menu_it_helpdesk_unassigned_tickets"
        name="미배정 문의"
        parent="menu_it_helpdesk_tickets"
        action="action_it_helpdesk_unassigned_tickets"
        groups="it_helpdesk.group_it_helpdesk_agent"
        sequence="20"
    />

    <!-- 담당자 전용 보관된 문의 목록 -->
    <record id="action_it_helpdesk_archived_tickets" model="ir.actions.act_window">
        <field name="name">보관된 문의</field>
        <field name="res_model">it.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', False)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="search_view_id" ref="view_it_helpdesk_ticket_search" />
    </record>

    <!-- 보관된 문의도 기존 전체 문의 List View 재사용 -->
    <record id="action_it_helpdesk_archived_tickets_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_it_helpdesk_ticket_list" />
        <field name="act_window_id" ref="action_it_helpdesk_archived_tickets" />
    </record>

    <!-- IT 담당자 전용 보관된 문의 메뉴 -->
    <menuitem
        id="menu_it_helpdesk_archived_tickets"
        name="보관된 문의"
        parent="menu_it_helpdesk_tickets"
        action="action_it_helpdesk_archived_tickets"
        groups="it_helpdesk.group_it_helpdesk_agent"
        sequence="30"
    />

    <!-- IT 담당자 전용 기준 정보 관리 -->
    <menuitem
        id="menu_it_helpdesk_configuration"
        name="설정"
        parent="menu_it_helpdesk_root"
        groups="it_helpdesk.group_it_helpdesk_agent"
        sequence="90"
    />

    <menuitem
        id="menu_it_helpdesk_categories"
        name="문의 유형"
        parent="menu_it_helpdesk_configuration"
        action="action_it_helpdesk_category"
        groups="it_helpdesk.group_it_helpdesk_agent"
        sequence="10"
    />

    <menuitem
        id="menu_it_helpdesk_faq_management"
        name="FAQ 관리"
        parent="menu_it_helpdesk_configuration"
        action="action_it_helpdesk_faq_management"
        groups="it_helpdesk.group_it_helpdesk_agent"
        sequence="20"
    />
</odoo>

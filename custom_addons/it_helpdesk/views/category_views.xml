<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_helpdesk_category_list" model="ir.ui.view">
        <field name="name">it.helpdesk.category.list</field>
        <field name="model">it.helpdesk.category</field>
        <field name="arch" type="xml">
            <list string="문의 유형">
                <field name="name" />
                <field name="code" />
                <field name="description" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_it_helpdesk_category_form" model="ir.ui.view">
        <field name="name">it.helpdesk.category.form</field>
        <field name="model">it.helpdesk.category</field>
        <field name="arch" type="xml">
            <form string="문의 유형">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="active" />
                    </group>
                    <group string="설명">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_it_helpdesk_category_search" model="ir.ui.view">
        <field name="name">it.helpdesk.category.search</field>
        <field name="model">it.helpdesk.category</field>
        <field name="arch" type="xml">
            <search string="문의 유형 검색">
                <field name="name" />
                <field name="code" />
                <filter
                    name="archived"
                    string="보관됨"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="action_it_helpdesk_category" model="ir.actions.act_window">
        <field name="name">문의 유형</field>
        <field name="res_model">it.helpdesk.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_it_helpdesk_category_search" />
    </record>
</odoo>
